# DataMind environment — copy to .env, fill in, NEVER commit .env
# (gitignored; see plan "no secrets in repo", gate G5)

# --- Gemma (Person A) ------------------------------------------------------
# Any OpenAI-compatible endpoint serving Gemma:
#   Ollama local:     http://localhost:11434/v1      (key can stay "ollama")
#   LM Studio local:  http://localhost:1234/v1
#   Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai/
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_API_KEY=ollama
GEMMA_MODEL=gemma3:12b
GEMMA_TIMEOUT=120

