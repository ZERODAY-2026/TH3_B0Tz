# Copy to .env (gitignored) and adjust. Real environment variables win over this file.
# Nothing here is a secret: LegalLens needs no keys, tokens or accounts.

# Local model server (llama-server or Ollama). Must be 127.0.0.1 or localhost:
# document text is sent here, and LegalLens refuses any other host.
GEMMA_BASE_URL=http://127.0.0.1:8080
# Ollama instead:
# GEMMA_BASE_URL=http://127.0.0.1:11434

# Seconds to wait for one model reply. 120 is plenty on a GPU (RTX 4060);
# use 900 on a CPU-only machine.
GEMMA_TIMEOUT=120

# Kill-switches. legallens/config.py already sets these to 1 at import time;
# only set HF_HUB_OFFLINE=0 temporarily if you download weights from Python.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
# For the Gradio UI (lane D):
GRADIO_ANALYTICS_ENABLED=False
